theorem succ_zero_eq_one : succ Z.zero = one := by
  sorry

                                                                         
theorem pred_zero_eq_neg_one : pred Z.zero = -one := by
  sorry

                                                                      
                               
theorem neg_one_lt_zero_lt_one : (-one : Z) < Z.zero ∧ (Z.zero : Z) < one := by
  sorry

