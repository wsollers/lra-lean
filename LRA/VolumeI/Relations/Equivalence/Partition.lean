import LRA.VolumeI.Relations.Equivalence.EquivalenceClass

namespace LRA.VolumeI.Relations

universe u

/-- A partition of a carrier by indexed nonempty, covering, disjoint blocks. -/
structure Partition (Alpha : LRA.VolumeI.Set.LRACarrier) where
  Index : Type u
  Block : Index -> LRA.VolumeI.Set.LRASet Alpha
  Covers : forall element : Alpha, exists index, Block index element
  NonemptyBlocks : forall index, LRA.VolumeI.Set.LRASet.Nonempty (Block index)
  DisjointOrEqual :
    forall firstIndex secondIndex,
      (exists element, Block firstIndex element /\ Block secondIndex element) ->
        Block firstIndex = Block secondIndex

/-- The partition generated by an equivalence relation. -/
def PartitionFromEquivalence {Alpha : LRA.VolumeI.Set.LRACarrier}
    (relation : Endorelation Alpha)
    (relationIsEquivalence : EquivalenceRelation relation) :
    Partition Alpha := by
  sorry

end LRA.VolumeI.Relations
